# ==============================================================================
# Variáveis de Ambiente para Produção na VPS (HostGator / Coolify / Docker)
# Copie este arquivo para .env.production e preencha com seus dados reais:
# ==============================================================================

# Conexão com o Banco de Dados PostgreSQL (Pode continuar usando o Neon ou banco local da VPS)
DATABASE_URL="postgresql://usuario:senha@ep-billowing-glade-aqg0ryn5-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-billowing-glade-aqg0ryn5.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave secreta de autenticação (Gere uma chave segura ou use a existente)
NEXTAUTH_SECRET="sua-chave-secreta-de-producao-muito-segura"
NEXTAUTH_URL="https://lajespintadas.rn.gov.br"

# URL pública do site
NEXT_PUBLIC_BASE_URL="https://lajespintadas.rn.gov.br"

# Armazenamento de Arquivos e Mídia (Cloudflare R2 / AWS S3 ou Vercel Blob)
# Exemplo Cloudflare R2 (Recomendado para VPS por ter custo zero de tráfego de saída):
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portal-lajes-pintadas"
R2_PUBLIC_URL="https://midia.lajespintadas.rn.gov.br"

# Ambiente
NODE_ENV="production"
PORT=3000
