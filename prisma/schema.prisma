  statusValidacao           String    @default("validado")         // validado, em_revisao, com_pendencia
  resultadoAvaliacaoExterna String?   @default("Atendido na Ficha Histórica")
  pendenciasTecnicas        String?
  pendenciasConteudo        String?
  evidenciaUrl              String?
